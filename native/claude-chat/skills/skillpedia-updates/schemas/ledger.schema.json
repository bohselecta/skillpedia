{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skillpedia ledger v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "environment": {
      "enum": [
        "personal",
        "corporate"
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial",
            "supplied-only"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "from": {
          "type": "string",
          "format": "date-time",
          "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "to": {
          "type": "string",
          "format": "date-time",
          "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "maxItems": 100
        }
      },
      "required": [
        "status",
        "scope",
        "from",
        "to",
        "retrieved_at",
        "limitations"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$"
          },
          "account": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "uri": {
            "type": "string",
            "pattern": "^(https://|urn:|user:)",
            "maxLength": 2000
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
          },
          "classification": {
            "enum": [
              "public",
              "personal",
              "internal",
              "restricted",
              "synthetic"
            ]
          }
        },
        "required": [
          "id",
          "account",
          "uri",
          "timestamp",
          "classification"
        ]
      },
      "maxItems": 10000
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$"
          },
          "item_version": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "enum": [
              "task",
              "issue",
              "risk",
              "decision",
              "note"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "state": {
            "enum": [
              "proposed",
              "needs_action",
              "waiting",
              "blocked",
              "decided",
              "done",
              "cancelled"
            ]
          },
          "owner_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "owner_status": {
            "enum": [
              "unknown",
              "proposed",
              "confirmed"
            ]
          },
          "due_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
              },
              {
                "type": "null"
              }
            ]
          },
          "follow_up_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
              },
              {
                "type": "null"
              }
            ]
          },
          "critical": {
            "type": "boolean"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$"
            },
            "maxItems": 10000,
            "uniqueItems": true,
            "minItems": 1
          },
          "resolution_source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$"
            },
            "maxItems": 10000,
            "uniqueItems": true
          },
          "next_action": {
            "type": "string",
            "maxLength": 500
          },
          "checked_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
          }
        },
        "required": [
          "id",
          "item_version",
          "kind",
          "summary",
          "state",
          "owner_id",
          "owner_status",
          "due_at",
          "follow_up_at",
          "critical",
          "source_ids",
          "resolution_source_ids",
          "next_action",
          "checked_at"
        ]
      },
      "maxItems": 10000
    }
  },
  "required": [
    "schema_version",
    "revision",
    "environment",
    "coverage",
    "sources",
    "items"
  ]
}
